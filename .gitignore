build/

# 编辑器 / 本地环境
.vscode/
.idea/
.env

# Windows 移植：构建产物与工具链拷来的运行时
windows/**/bin/
windows/**/obj/
windows/publish/
windows/installer/Output/
windows/BoxSend.Windows/native/*.dll
windows/installer/version.inc

# Rust 构建产物
rust/target/
.workbuddy/
# 会话导出/临时材料（不入库）
/适配SBPT发种辅种_*.md
# 实机调试下载的站点种子（含 passkey，绝不入库；Tests/ 的固定样例不受影响）
/*.torrent
# 实机发种/浏览器证据目录（含 passkey 种子、页面截图、回包原文，整目录不入库）
/artifacts/
# 根目录一次性调试输出（命令回显、回包原文、页面截图、review/gatecheck 草稿）
/*.txt
/*.html
/bsend-batch-*.md
/gatecheck-*.json
/rust/*.txt
